#include <stdlib.h>
#include <string.h>

char** findRepeatedDnaSequences(char* s, int* returnSize) {
    *returnSize = 0;
    int len = strlen(s);
    if (len < 10) return NULL;

    unsigned char* seen = (unsigned char*)calloc(1048576, sizeof(unsigned char));
    
    char** result = (char**)malloc(sizeof(char*) * (len - 9));
    
    int map[26];
    map['A' - 'A'] = 0;
    map['C' - 'A'] = 1;
    map['G' - 'A'] = 2;
    map['T' - 'A'] = 3;

    int hash = 0;
    for (int i = 0; i < 9; i++) {
        hash = (hash << 2) | map[s[i] - 'A'];
    }

    for (int i = 9; i < len; i++) {
        hash = ((hash << 2) | map[s[i] - 'A']) & 0xFFFFF;

        if (seen[hash] == 1) {
            result[*returnSize] = (char*)malloc(sizeof(char) * 11);
            strncpy(result[*returnSize], &s[i - 9], 10);
            result[*returnSize][10] = '\0';
            (*returnSize)++;
            seen[hash] = 2; 
        } else if (seen[hash] == 0) {
            seen[hash] = 1; 
        }
    }

    free(seen);
    return result;
}

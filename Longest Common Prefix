#include <string.h>

char* longestCommonPrefix(char** strs, int strsSize) {
    if (strsSize == 0) {
        return "";
    }
    
        char* base = strs[0];
    
    for (int i = 0; base[i] != '\0'; i++) {
        char currentChar = base[i];
        
        for (int j = 1; j < strsSize; j++) {
            if (strs[j][i] == '\0' || strs[j][i] != currentChar) {
                base[i] = '\0'; 
                return base;
            }
        }
    }
    
    return base;
}
